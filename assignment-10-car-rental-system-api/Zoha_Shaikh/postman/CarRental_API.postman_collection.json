        {
          "name": "Book Rental for Pickup/Complete Flow",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const addDays = (days) => {",
                  "    const d = new Date(Date.UTC(now.getUTCFullYear() + 1, now.getUTCMonth(), now.getUTCDate() + days));",
                  "    return d.toISOString().split('T')[0];",
                  "};",
                  "pm.variables.set(\"flowStart\", addDays(60));",
                  "pm.variables.set(\"flowEnd\", addDays(65));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.rental && json.rental.id) {",
                  "    pm.environment.set(\"pickupRentalId\", json.rental.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": 4,\n  \"start_date\": \"{{flowStart}}\",\n  \"end_date\": \"{{flowEnd}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rentals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rentals"]
            }
          }
        },
        {
          "name": "Pickup Rental (booked -> active, vehicle -> rented)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.rental.status).to.eql('active');",
                  "pm.expect(json.vehicle_status).to.eql('rented');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rentals/{{pickupRentalId}}/pickup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rentals", "{{pickupRentalId}}", "pickup"]
            }
          }
        },
        {
          "name": "Complete Rental (active -> completed, vehicle -> available)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.rental.status).to.eql('completed');",
                  "pm.expect(json.vehicle_status).to.eql('available');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rentals/{{pickupRentalId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rentals", "{{pickupRentalId}}", "complete"]
            }
          }
        }
      ]
    }
  ]
}
