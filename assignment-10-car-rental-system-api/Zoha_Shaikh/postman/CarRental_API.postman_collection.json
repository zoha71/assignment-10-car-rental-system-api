    {
      "name": "4. Dynamic Future Date Collision Matrix",
      "item": [
        {
          "name": "1. Base Dynamic Booking (Days +30 to +35)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const now = new Date();",
                  "const addDays = (days) => {",
                  "    const d = new Date(Date.UTC(now.getUTCFullYear() + 1, now.getUTCMonth(), now.getUTCDate() + days));",
                  "    return d.toISOString().split('T')[0];",
                  "};",
                  "pm.variables.set(\"dynStart\", addDays(30));",
                  "pm.variables.set(\"dynEnd\", addDays(35));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.rental.totalDays).to.eql(6);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_id\": 2,\n  \"start_date\": \"{{dynStart}}\",\n  \"end_date\": \"{{dynEnd}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rentals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rentals"]
            }
          }
        },
